        <body>  
            <div id="header">
                <center>
                    <div style="font-size:{text:title size}px;margin:0 0 10px 0"><a href="/">{block:ifcustomtitle}{text:title}{/block:ifcustomtitle}{block:ifnotcustomtitle}{Title}{/block:ifnotcustomtitle}</a></div>
